# Copy to .env and adjust if needed: cp .env.example .env
# Local development values only. Never commit a real .env.

# ---------------------------------------------------------------------------
# Database: pick ONE of the three options below (see README "Database").
# The app only reads DATABASE_URL; it does not care how Postgres is run.
# ---------------------------------------------------------------------------

# Option A: Docker (npm run db:up). Uses the POSTGRES_* values below.
DATABASE_URL="postgresql://sms:sms@localhost:5432/sms?schema=public"

# Option B: no Docker, no Postgres install (npm run db:local, uses Prisma's embedded Postgres)
# DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Option C: your own Postgres 14+ (local install, Neon, Supabase, ...).
# The database is created on the first `npm run dev` if the user has permission.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sms?schema=public"

# Only used by docker-compose.yml (Option A)
POSTGRES_USER=sms
POSTGRES_PASSWORD=sms
POSTGRES_DB=sms
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# Where uploaded assessment files are stored (relative to project root)
UPLOAD_DIR=storage/uploads

# Maximum upload size in megabytes
MAX_UPLOAD_MB=10
